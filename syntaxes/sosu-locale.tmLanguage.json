{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sosu catalog",
  "scopeName": "source.sosu-locale",
  "comment": "Catalogs of translations, <name>.locale.<language>.sosu: the content of gettext (.po).",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.reference.sosu-locale", "match": "^#:.*$" },
        { "name": "comment.line.flags.sosu-locale", "match": "^#,.*$" },
        { "name": "comment.line.extracted.sosu-locale", "match": "^#\\..*$" },
        { "name": "comment.line.number-sign.sosu-locale", "match": "^#.*$" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.other.msgctxt.sosu-locale", "match": "^\\s*msgctxt\\b" },
        { "name": "keyword.other.msgid.sosu-locale", "match": "^\\s*msgid(_plural)?\\b" },
        {
          "match": "^\\s*(msgstr)(?:(\\[)(\\d+)(\\]))?",
          "captures": {
            "1": { "name": "keyword.other.msgstr.sosu-locale" },
            "2": { "name": "punctuation.definition.index.begin.sosu-locale" },
            "3": { "name": "constant.numeric.integer.sosu-locale" },
            "4": { "name": "punctuation.definition.index.end.sosu-locale" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sosu-locale",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.sosu-locale", "match": "\\\\[\"\\\\nt]" },
        { "name": "variable.other.placeholder.sosu-locale", "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}" }
      ]
    }
  }
}
