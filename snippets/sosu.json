{
  "Program": {
    "prefix": "main",
    "description": "The entry of a program",
    "body": ["import std.io;", "", "i32 main() uses io {", "\tio.print(\"${1:Hello, Sosu!}\");", "\treturn 0;", "}"]
  },
  "Function": {
    "prefix": "fn",
    "description": "A function",
    "body": ["${1:void} ${2:name}(${3}) {", "\t$0", "}"]
  },
  "Function with contracts": {
    "prefix": "fnc",
    "description": "A function with `requires` and `ensures`",
    "body": ["${1:i32} ${2:name}(${3:i32 x})", "\trequires ${4:x > 0}", "\tensures ${5:result > 0}", "{", "\t$0", "}"]
  },
  "Struct": {
    "prefix": "struct",
    "description": "A struct: a value, copied",
    "body": ["pub struct ${1:Name} {", "\tpub ${2:f32} ${3:x};", "}"]
  },
  "Class": {
    "prefix": "class",
    "description": "A class, created in an arena",
    "body": ["pub class ${1:Name} {", "\tmut ${2:i32} ${3:count};", "", "\tvoid init() {", "\t\t${3:count} = 0;", "\t}", "}"]
  },
  "Interface": {
    "prefix": "interface",
    "description": "An interface",
    "body": ["pub interface ${1:Name} {", "\t${2:void} ${3:method}();", "}"]
  },
  "Enum": {
    "prefix": "enum",
    "description": "A sum type",
    "body": ["pub enum ${1:Name} {", "\t${2:First},", "\t${3:Second}(${4:i32 value}),", "}"]
  },
  "Match": {
    "prefix": "match",
    "description": "An exhaustive match",
    "body": ["match (${1:value}) {", "\t${2:Variant} => {", "\t\t$0", "\t},", "\t_ => { },", "}"]
  },
  "If": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"]
  },
  "For range": {
    "prefix": "for",
    "description": "A loop over a range",
    "body": ["for (${1:i32} ${2:i} in ${3:0}..${4:n}) {", "\t$0", "}"]
  },
  "While": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"]
  },
  "Arena": {
    "prefix": "arena",
    "description": "An arena, freed at the end of the scope",
    "body": ["mut Arena ${1:arena} = Arena.new(${2:1} * ${3|KB,MB|});", "defer ${1:arena}.free();"]
  },
  "Test": {
    "prefix": "test",
    "description": "A test block, run by `sosuc test`",
    "body": ["test \"${1:what it checks}\" {", "\tassert(${2:true});", "}"]
  },
  "Extern": {
    "prefix": "extern",
    "description": "C functions",
    "body": ["extern \"C\" {", "\t${1:i32} ${2:puts}(${3:ui8* s});", "}"]
  }
}
